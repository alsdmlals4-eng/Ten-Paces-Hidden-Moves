{
  "schema_version": 2,
  "data_role": "NON_RUNTIME_POC_PLANNING",
  "status": "APPROVED_PLANNING",
  "editable": true,
  "owner": "docs/09_COMBAT_SYSTEM_ARCHITECTURE.md",
  "permanent_profile_state": {
    "fields": [
      "permanent_currency"
    ],
    "rollback_with_run_state": false
  },
  "run_state": {
    "fields": [
      "run_id",
      "run_seed",
      "current_node_id",
      "visited_node_ids",
      "current_health",
      "maximum_health",
      "money",
      "manual_mastery_by_id",
      "unlocked_technique_ids",
      "medical",
      "current_battle_id",
      "same_battle_retry_count"
    ],
    "health_carries_between_battles": true,
    "temporary_combat_statuses_persist": false
  },
  "combat_state": {
    "fields": [
      "round_number",
      "bundle_index",
      "player_tile",
      "enemy_tile",
      "health",
      "stamina",
      "internal",
      "momentum",
      "defense",
      "evade_stacks",
      "sure_hit_stacks",
      "fortitude_stacks",
      "temporary_statuses",
      "committed_actions"
    ],
    "entry_reset": {
      "stamina": "MAXIMUM",
      "internal": "MAXIMUM",
      "momentum": 0,
      "temporary_statuses": "CLEAR",
      "positions": "BATTLE_DEFINITION"
    },
    "entry_copy_from_run_state": [
      "health",
      "maximum_health",
      "medical",
      "unlocked_technique_ids"
    ]
  },
  "pre_battle_snapshot": {
    "id": "PRE_BATTLE_RUN_STATE",
    "created_before_permanent_currency_charge": true,
    "includes_all_run_state_fields": true,
    "excludes_permanent_profile_state": true
  },
  "victory_commit": {
    "health_formula": "min(maximum_health, combat_health + 2 + medical)",
    "grant_reward_once": true,
    "advance_node_once": true,
    "reset_retry_counter_when_next_battle_differs": true
  },
  "defeat_retry": {
    "restore_snapshot": "PRE_BATTLE_RUN_STATE",
    "same_seed": true,
    "rollback": [
      "battle_damage",
      "battle_resource_changes",
      "temporary_statuses",
      "unearned_rewards",
      "node_advance"
    ],
    "permanent_currency_costs_same_battle": [
      1,
      2,
      3
    ],
    "cost_cap": 3,
    "counter_reset": "WHEN_ENTERING_DIFFERENT_BATTLE",
    "charge_order": "CHECK_BALANCE_THEN_CHARGE_THEN_RESTORE",
    "cost_basis": "PRE_RETRY_COUNTER",
    "counter_value_source": "READ_BEFORE_CHARGE_AND_RESTORE",
    "transition_order": "READ_COUNTER_COMPUTE_COST_CHECK_BALANCE_CHARGE_RESTORE_INCREMENT_COUNTER_PERSIST",
    "counter_update": "PREVIOUS_PLUS_ONE_AFTER_RESTORE",
    "insufficient_currency": [
      "ABANDON_RUN",
      "RETURN_TO_TITLE"
    ],
    "paid_currency_is_not_rolled_back": true
  },
  "save_compatibility": {
    "save_field": "runtime_catalog_digest",
    "digest_algorithm": "SHA256_CANONICAL_JSON",
    "canonical_source_files": [
      "poc_martial_arts.json",
      "poc_enemy_duels.json",
      "poc_map_rewards.json",
      "poc_balance_budget.json",
      "poc_run_state_contract.json"
    ],
    "excluded_nondeterministic_fields": [
      "generated_at",
      "created_at"
    ],
    "mismatch_result": "INCOMPATIBLE_SAVE_CATALOG",
    "implicit_repair_on_mismatch": false,
    "runtime_implementation": "NOT_STARTED"
  },
  "debug_restart_boundary": {
    "legacy_t0_restart_is_not_paid_run_retry": true,
    "available_in_poc_run_flow": false
  }
}
